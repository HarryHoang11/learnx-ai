# ============================================================
# DATABASE
# ============================================================
# Connection string tới Postgres. Nếu dùng Supabase, lấy trong
# Project Settings > Database > Connection string (chọn "URI").
# pgvector extension phải được bật trong DB này (xem prisma/schema.prisma).
DATABASE_URL="postgresql://user:password@localhost:5432/learnx"

# ============================================================
# AUTH.JS (NextAuth v5)
# ============================================================
# Secret dùng để ký JWT session. Bắt buộc phải có ở production.
# Tạo nhanh bằng lệnh: openssl rand -base64 32
AUTH_SECRET="change-this-to-a-random-long-string"

# --- URL công khai của app (BẮT BUỘC khi self-host production) ---
# Vercel/Cloudflare TỰ set biến nhận diện nền tảng nên bỏ trống vẫn chạy.
# Nhưng nếu deploy bằng Docker/VPS (`next start` sau Nginx), Auth.js KHÔNG
# tin Host header và mọi endpoint /api/auth/* sẽ trả HTTP 500
# (UntrustedHost). Khi đó chọn 1 trong 2:
#   AUTH_URL="https://learnx.example.com"   # khuyến nghị
#   AUTH_TRUST_HOST="true"
AUTH_URL=""
AUTH_TRUST_HOST=""

# --- Google OAuth ---
# Lấy tại: https://console.cloud.google.com/apis/credentials
# 1. Tạo OAuth Client ID, loại "Web application"
# 2. Authorized redirect URI: http://localhost:3000/api/auth/callback/google
#    (khi deploy thật, đổi domain tương ứng)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ============================================================
# AI PROVIDER
# ============================================================
# API key của Google AI Studio (dùng cho model Gemini).
# Lấy tại: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your-gemini-api-key"

# Tên model Gemini dùng cho generateContent. Để trống sẽ dùng mặc định
# "gemini-flash-latest" (alias Google tự trỏ tới bản Flash GA mới nhất).
# Google thường xuyên gỡ các model cũ khỏi API (vd dòng 1.5, rồi 2.0,
# sắp tới là 2.5) — nếu gặp lỗi 404 "model is not found for API version
# v1beta", tra danh sách model còn hỗ trợ tại
# https://ai.google.dev/gemini-api/docs/models rồi set biến này thay vì
# sửa code.
GEMINI_MODEL="gemini-flash-latest"

# Model dùng cho embedContent (RAG — biến tài liệu thành ngữ cảnh cho AI).
# "text-embedding-004" đã bị Google shutdown (14/1/2026); model thay thế
# chính thức là "gemini-embedding-001" (vector 3072 chiều, code cắt về 768
# chiều đầu + L2-normalize để khớp cột vector(768) trong DB).
GEMINI_EMBEDDING_MODEL="gemini-embedding-001"

# Provider fallback khi Gemini quá tải/lỗi — không bắt buộc, nếu để
# trống thì router tự động SKIP (không crash app). Xem lib/ai/router.ts.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"        # optional, có default

OPENROUTER_API_KEY=""
OPENROUTER_MODEL="meta-llama/llama-3.3-70b-instruct:free"   # optional, có default

# --- DeepSeek (fallback thứ 3) ---
# Lấy key tại: https://platform.deepseek.com/api_keys
# DeepSeek dùng API tương thích OpenAI (POST {base}/chat/completions).
# Base URL mặc định là "https://api.deepseek.com" — chỉ set DEEPSEEK_BASE_URL
# khi đi qua proxy/gateway nội bộ.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=""                    # optional, có default
DEEPSEEK_MODEL="deepseek-flash"         # optional, có default

# --- Qwen (Alibaba Cloud Model Studio / DashScope — fallback thứ 4) ---
# Lấy key tại: https://modelstudio.console.alibabacloud.com/
# QWEN_BASE_URL là BẮT BUỘC (không có default trong code) vì DashScope có
# base URL khác nhau theo REGION, và API key cũng theo region — dùng key
# region A với endpoint region B sẽ bị 401. Chọn đúng 1 dòng dưới đây:
#   Singapore:       https://dashscope-intl.aliyuncs.com/compatible-mode/v1
#   China (Beijing): https://dashscope.aliyuncs.com/compatible-mode/v1
#   US (Virginia):   https://dashscope-us.aliyuncs.com/compatible-mode/v1
#   Hong Kong:       https://cn-hongkong.dashscope.aliyuncs.com/compatible-mode/v1
# Xem đầy đủ: https://help.aliyun.com/en/model-studio/base-url
QWEN_API_KEY=""
QWEN_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-flash"                 # optional, có default

# Tên/domain app hiển thị trên dashboard OpenRouter (không bắt buộc để
# request chạy được).
APP_URL="http://localhost:3000"
APP_NAME="LearnX AI"

# ============================================================
# STORAGE — HIỆN KHÔNG ĐƯỢC CODE NÀO ĐỌC
# ============================================================
# Giữ lại để tham chiếu khi nâng cấp: hiện tại tài liệu Library lưu file
# gốc + chunk trong Postgres, còn avatar/cover lưu ở cột Bytes
# (Document.fileData / User.avatarData). Hai biến dưới đây KHÔNG có tác
# dụng — đặt giá trị cũng không thay đổi hành vi app.
STORAGE_BUCKET_URL=""
STORAGE_BUCKET_KEY=""
