# --- Secrets: KHÔNG bao giờ commit file env thật (chỉ .env.example có placeholder) ---
/.env
/.env.local
/.env*.local

# --- Dependencies ---
/node_modules
node_modules/

# --- Build output: Next.js + TypeScript incremental info ---
/.next
/out
/build
tsconfig.tsbuildinfo

# --- Vercel + file upload local + file tạm khi debug ---
.vercel
/public/uploads
*.log
*-out.txt

# --- Artifact sinh TỰ ĐỘNG — không thuộc source, không commit ---
# graphify-out/: output của công cụ dựng code-graph (JSON/HTML/cache AST).
# Nặng ~13MB / 141 file, sinh lại được, và gây nhiễu diff mỗi lần chạy.
graphify-out/

# IDE — cấu hình máy từng người, không liên quan tới dự án
.idea/
.vscode/

# Ảnh chụp màn hình QA tạm
_qa_shot*.png
